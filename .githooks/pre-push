#!/usr/bin/env bash
# pre-push hook: reject pushing a tag whose name looks like a release
# (X.Y.Z or X.Y.Z-<suffix>) but whose pointed-to commit fails the
# version-bump contract enforced by tools/deploy-check.
#
# `reference-transaction` refuses such a tag as it is written, so this
# hook is what catches one written before the hooks were installed.
set -euo pipefail

# stdin format (one per ref):  <local-ref> <local-sha> <remote-ref> <remote-sha>
# Buffer it so the cheap shell-side filter can decide whether to
# spawn cargo at all.
input=$(cat)
if [ -z "$input" ]; then
  exit 0
fi

lib_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
source "$lib_dir/version-literal.sh"

needs_check=0
while IFS=' ' read -r local_ref local_sha _ _; do
  [ -z "${local_ref:-}" ] && continue
  case "$local_ref" in
    refs/tags/*) ;;
    *) continue ;;
  esac
  if ! is_version_literal "${local_ref#refs/tags/}"; then
    continue
  fi
  if [[ "$local_sha" != *[!0]* ]]; then
    # Tag deletion, so nothing to verify.
    continue
  fi
  needs_check=1
  break
done <<< "$input"

if [ "$needs_check" -eq 0 ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

# See `.githooks/commit-msg-hooks/release-contract` for why the linker
# override is here.
#
# No `--quiet`: a cold build takes seconds, and a silent hook looks
# hung. Cargo's progress goes to stderr and hooks signal via exit
# code, so surfacing it is harmless.
exec cargo --config 'target."cfg(all())".linker="cc"' run \
  --locked --package _deploy_check --bin deploy-check -- \
  "$root" pre-push <<< "$input"
