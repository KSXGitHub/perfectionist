#!/usr/bin/env bash
# commit-msg hook: reject release-shaped commit messages (X.Y.Z or
# X.Y.Z-<suffix>) whose staged diff fails the version-bump contract
# enforced by tools/deploy-check.
set -euo pipefail

msg_file="$1"

# Cheap pre-filter so non-release commits don't pay the cost of
# spawning cargo. Find the first non-blank, non-comment line and
# check whether it matches the version-literal grammar.
subject=$(grep -v '^#' "$msg_file" | awk 'NF{print; exit}')
if ! [[ "$subject" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[^[:space:]]+)?$ ]]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

# `dylint-link` is the workspace linker per `.cargo/config.toml`, so
# this hook must work even on a fresh checkout where
# `just install-dev-tools` has not run yet — mirror that recipe's
# linker override.
exec cargo --config 'target."cfg(all())".linker="cc"' run \
  --quiet --locked --package _deploy_check --bin deploy-check -- \
  "$root" commit-msg "$msg_file"
