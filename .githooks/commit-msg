#!/usr/bin/env bash
# commit-msg hook: a thin dispatcher. Each independent check lives in
# its own file under `.githooks/commit-msg-hooks/` and is called in turn
# against the message file. The first check that rejects aborts the
# commit (`set -e`); the expensive release-contract check is called last
# so the cheap pure-text checks fail fast. Shared helpers the checks
# source live in `.githooks/lib/commit-msg.sh`.
set -euo pipefail

msg_file="$1"
hooks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/commit-msg-hooks"

"$hooks_dir/bare-issue-refs" "$msg_file"
"$hooks_dir/bare-mentions" "$msg_file"
"$hooks_dir/subject-length" "$msg_file"
"$hooks_dir/release-contract" "$msg_file"
