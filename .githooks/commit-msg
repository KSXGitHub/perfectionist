#!/usr/bin/env bash
# commit-msg hook: a thin dispatcher. Each independent check lives in
# its own file under `.githooks/commit-msg.d/` and is run in turn,
# numeric-prefix order, against the message file. The first check that
# rejects aborts the commit; the expensive release-contract check is
# last so the cheap pure-text checks fail fast. Shared helpers the
# checks source live in `.githooks/lib/commit-msg.sh`.
set -euo pipefail

msg_file="$1"
checks_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/commit-msg.d"

for check in "$checks_dir"/*; do
  [ -x "$check" ] || continue
  "$check" "$msg_file"
done
