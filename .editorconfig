root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{js,css}]
indent_style = space
indent_size = 2

# A unified diff spells an empty context line as a bare space, and an
# empty added or removed line as a bare marker, so trimming the line
# would corrupt the round fixtures under `tests/fixtures/autofix/`.
[*.diff]
trim_trailing_whitespace = false
